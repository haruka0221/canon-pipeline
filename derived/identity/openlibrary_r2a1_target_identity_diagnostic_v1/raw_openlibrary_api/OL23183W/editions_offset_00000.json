s":[{"key":"/works/OL23183W"}],"covers":[14813346],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-11-11T10:02:11.731203"},"last_modified":{"type":"/type/datetime","value":"2025-12-02T07:25:10.130461"}},{"publishers":["Penguin Books"],"identifiers":{"amazon":["0140150021"],"google":["3jDuAAAAMAAJ"],"goodreads":["425993"],"librarything":["161437"]},"description":{"type":"/type/text","value":"He wrote about poor people struggling to survive and about dispossessed people grappling for a piece of land they could call their own. He wrote about inarticulate men groping to express truths “locked in wordlessness.” He wrote about America—the land and the people—as though it were one living organism, and he did so more eloquently than anyone since Walt Whitman. In an extraordinarily prolific career that lasted from 1929 to the 1960s, John Steinbeck created stories and characters that, in the words of Pascal Covici, Jr., this volume’s editor, combine “the gusto of Homer … along with the thoughtfulness of Emerson.”The Portable Steinbeck is a grand sampling of this writer’s most important works.\r\n--back cover"},"covers":[95939],"last_modified":{"type":"/type/datetime","value":"2020-01-23T10:28:35.140245"},"latest_revision":9,"key":"/books/OL7348853M","authors":[{"key":"/authors/OL25788A"},{"key":"/authors/OL542205A"}],"publish_places":["New York, USA"],"edition_name":"Revised edition, reprint (29)","languages":[{"key":"/languages/eng"}],"classifications":{},"source_records":["amazon:0140150021:o-9:3039595470:212794","amazon:0140150021:10:2611900913:206467"],"title":"The Portable Steinbeck","notes":{"type":"/type/text","value":"UK/CAN/USA"},"number_of_pages":736,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"isbn_13":["9780140150025"],"isbn_10":["0140150021"],"publish_date":"1976","copyright_date":"1971","oclc_numbers":["909413777"],"works":[{"key":"/works/OL23183W"}],"type":{"key":"/type/edition"},"revision":9},{"pub