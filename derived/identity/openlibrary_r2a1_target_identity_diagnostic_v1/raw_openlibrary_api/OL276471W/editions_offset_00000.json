:[{"key":"/works/OL276471W"}],"oclc_numbers":["40839743"],"description":{"type":"/type/text","value":"\"Henry James, author of such classics of fiction as A Portrait of a Lady and The Wings of the Dove, remains one of America's greatest and most influential writers. This fully annotated selection from his eloquent correspondence allows the writer to reveal himself and the fascinating world in which he lived. James numbered among his correspondents the writers William Dean Howells, Henry Adams, Robert Louis Stevenson, H.G. Wells and Edith Wharton, as well as presidents and prime ministers, painters and great ladies, actresses and bishops. These letters provide a rich and fascinating source for James's views on his own works, on the literary craft, on sex, politics and friendship, and collectively constitute, in Philip Horne's own words, James's 'real and best biography'.\"--Jacket."},"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-08-30T17:09:45.604830"}},{"publishers":["Appleton-Century-Crofts"],"identifiers":{"librarything":["2661241"]},"table_of_contents":[{"level":0,"label":"","title":"The marriages.","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Europe.","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The liar.","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The real thing.","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The pupil.","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The beast in the jungle.","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The jolly corner.","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Topics for further reading and writing (p. 309-310)","pagenum":"","type":{"key":"/type/toc_item"}}],"series":["Goldentree books"],